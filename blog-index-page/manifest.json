{
  "name": "blog-index-page",
  "version": "2.0.0",
  "title": "Blog Index Page",
  "description": "Blog listing: post cards with a category filter and static pagination, from MDX files, in the project's design system",
  "type": "page",
  "category": "BLOG",
  "tags": ["blog", "index", "listing", "pagination", "design-tokens"],
  "stack": ["react", "next", "tailwind", "mdx", "zod"],
  "family": "site",
  "tokens": 1,
  "parts": [
    { "slug": "blog-content", "version": "2.0.0", "into": "_parts/blog-content" },
    { "slug": "blog-card", "version": "2.0.0", "into": "_parts/blog-card" },
    { "slug": "component-pagination", "version": "2.0.0", "into": "_parts/component-pagination" }
  ],
  "outputDir": "app/blog",
  "files": [
    "page.tsx",
    "page/[page]/page.tsx",
    "blog-index.tsx",
    "content.ts",
    "labels.ts",
    "labels.de.ts",
    "README.md",
    "_parts/blog-card/README.md",
    "_parts/blog-card/blog-card.tsx",
    "_parts/blog-card/format-date.ts",
    "_parts/blog-card/labels.de.ts",
    "_parts/blog-card/labels.ts",
    "_parts/blog-card/site-types.ts",
    "_parts/blog-content/README.md",
    "_parts/blog-content/blog-paths.ts",
    "_parts/blog-content/blog.ts",
    "_parts/blog-content/collection.ts",
    "_parts/blog-content/front-matter.ts",
    "_parts/blog-content/index.ts",
    "_parts/blog-content/mdx-components.tsx",
    "_parts/blog-content/mdx.ts",
    "_parts/blog-content/reading-time.ts",
    "_parts/blog-content/site-types.ts",
    "_parts/component-pagination/README.md",
    "_parts/component-pagination/labels.de.ts",
    "_parts/component-pagination/labels.ts",
    "_parts/component-pagination/page-window.ts",
    "_parts/component-pagination/pagination.tsx",
    "_parts/component-pagination/site-types.ts"
  ],
  "proof": "installs alone on Next 16 at app/blog; default look equals 1.0.0; 3 sample brands, light and dark, at 390/768/1280 px in two host apps; axe clean; no leak; parts byte-identical; mutants caught",
  "peerDependencies": {
    "react": ">=19",
    "next": ">=16",
    "tailwindcss": ">=4",
    "zod": ">=3",
    "@mdx-js/mdx": ">=3",
    "yaml": ">=2"
  },
  "postMessage": "Installed at app/blog/ (served at /blog). Posts go in content/blog/ (see app/blog/_parts/blog-content/README.md); needs @mdx-js/mdx, yaml and zod. Edit content.ts; see README.md."
}
