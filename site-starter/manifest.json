    "scripts/assemble-standalone.mjs",
    "scripts/design-sync.mjs",
    "src/app/globals.css",
    "src/app/layout.tsx",
    "src/app/not-found.tsx",
    "src/app/page.tsx",
    "src/app/pages.test.tsx",
    "src/app/robots.ts",
    "src/app/sitemap.ts",
    "src/components/SiteFooter.tsx",
    "src/components/SiteHeader.tsx",
    "src/content/claims.test.ts",
    "src/content/site.ts",
    "src/design/.gitkeep",
