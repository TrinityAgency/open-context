    "src/app/sitemap.ts",
    "src/components/HomePage.tsx",
    "src/components/NotFoundView.tsx",
    "src/components/SiteFooter.tsx",
    "src/components/SiteHeader.tsx",
    "src/content/claims.test.ts",
    "src/content/locale.ts",
    "src/content/site.ts",
    "src/design-system/generated/components.css",
