{
  "name": "site-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A company website: Next 16, Tailwind 4 without preflight, design tokens from a claude.ai design system, guard tests.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/assemble-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "design:sync": "node src/design-system/design-tokens/design-sync.mjs --config design-sync.config.json",
    "design:check": "node src/design-system/design-tokens/design-sync.mjs --config design-sync.config.json --check",
    "design:diff": "node src/design-system/design-tokens/design-sync.mjs --config design-sync.config.json --diff",
    "design:guards": "node src/design-system/design-tokens/design-sync.mjs --config design-sync.config.json --guards",
    "test": "pnpm design:check && pnpm design:guards && pnpm typecheck && vitest run"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9",
    "vitest": "^5.0.4"
  }
}
