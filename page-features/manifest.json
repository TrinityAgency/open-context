{
  "name": "page-features",
  "version": "1.0.0",
  "title": "Features Page",
  "description": "Features page: feature groups with icon, text and image, then a call to action",
  "type": "page",
  "category": "WEB_DESIGN",
  "tags": [
    "features",
    "marketing",
    "page",
    "sections"
  ],
  "stack": [
    "react",
    "next",
    "tailwind"
  ],
  "family": "site",
  "parts": [
    {
      "slug": "section-hero",
      "version": "2.0.0",
      "into": "_sections/hero"
    },
    {
      "slug": "section-features",
      "version": "2.0.0",
      "into": "_sections/features"
    },
    {
      "slug": "section-cta",
      "version": "2.0.0",
      "into": "_sections/cta"
    }
  ],
  "outputDir": "app/page-features",
  "files": [
    "README.md",
    "content.ts",
    "features-page.tsx",
    "page.tsx",
    "_sections/cta/README.md",
    "_sections/cta/cta-section.tsx",
    "_sections/cta/site-types.ts",
    "_sections/features/README.md",
    "_sections/features/features-section.tsx",
    "_sections/features/site-types.ts",
    "_sections/hero/README.md",
    "_sections/hero/hero-section.tsx",
    "_sections/hero/site-types.ts"
  ],
  "proof": "installs alone on Next 16 (build, typecheck, lint); same layout with and without preflight; axe clean; sections byte-identical to their pinned versions",
  "peerDependencies": {
    "react": ">=19",
    "next": ">=16",
    "tailwindcss": ">=4"
  },
  "postMessage": "Installed at app/page-features/ (served at /page-features; rename the folder for another path). Edit content.ts; see README.md."
}
